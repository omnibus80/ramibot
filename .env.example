# Optional OSIRIS integrations; public/keyless feeds work without these keys.
SCANNER_URL=
SCANNER_KEY=
FIRMS_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
N2YO_API_KEY=
AIS_API_KEY=

# === Provider API Keys ===
# Get your keys from the respective provider dashboards:
#   OpenAI:      https://platform.openai.com/api-keys
#   Anthropic:   https://console.anthropic.com/
#   OpenRouter:  https://openrouter.ai/keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# === Local Provider URLs ===
# Adjust these to match your local LM Studio / Ollama setup
LMSTUDIO_BASE_URL=http://127.0.0.1:1234
OLLAMA_BASE_URL=http://localhost:11434

# === App Settings ===
DATABASE_URL=sqlite:///./ramibot.db
CORS_ORIGINS=http://localhost:5173
